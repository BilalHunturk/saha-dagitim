# Copy to .env.local and fill in.
# Local development: run `npx supabase start`, then copy values from `npx supabase status -o env`
# (API_URL, ANON_KEY, SERVICE_ROLE_KEY). Production: Supabase dashboard > Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_, never import outside lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: satellite raster tile URL template ({z}/{x}/{y}).
# Leave empty to use the default (Esri World Imagery). Check the provider's terms before production use.
NEXT_PUBLIC_SATELLITE_TILE_URL=
